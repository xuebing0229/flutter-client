[Unit]
Description=Adventure Guild activation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adventure-license
Group=adventure-license
EnvironmentFile=/etc/adventure-license/service.env
ExecStart=/usr/bin/python3 /opt/adventure-license/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/adventure-license
WorkingDirectory=/opt/adventure-license

[Install]
WantedBy=multi-user.target
