{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adventure-license",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adventure-license",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
